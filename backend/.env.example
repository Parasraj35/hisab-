PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/hisab
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# devEcho returns the code in the API response so you can test without a
# real inbox. Force-disabled whenever NODE_ENV=production, regardless of
# this value.
OTP_TTL_SECONDS=300
OTP_DEV_ECHO=true
# OTP codes are emailed via Resend (resend.com) — grab an API key from
# their dashboard. Leave EMAIL_FROM as-is until you verify your own
# sending domain there.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=HISAB <onboarding@resend.dev>
